# SQLite (dev local — padrão se DATABASE_URL não estiver definido)
# DATABASE_URL=sqlite:///./data/athena.db

# Postgres direto (SQLAlchemy) — opcional se usar só o pacote supabase-py
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[SENHA]@aws-0-us-east-2.pooler.supabase.com:6543/postgres

ATHENA_SECRET=athena-gym-dev-secret-change-me
ATHENA_TOKEN_HOURS=168
ATHENA_CORS=*

# --- Pacote oficial supabase (supabase-py) ---
# Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # ou anon JWT (eyJ...)
SUPABASE_SECRET_KEY=sb_secret_...             # ou service_role JWT (eyJ...) — só backend
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Aliases aceitos pela API
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Senha do DB (Settings → Database) — usada por scripts/apply_sql_supabase.py
# SUPABASE_PASSWORD=your-db-password
# Ou URL direta (porta 5432), preferível ao pooler 6543:
# DATABASE_URL_DIRECT=postgresql://postgres:SENHA@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Ollama Cloud — Athena AI
# OLLAMA_API_KEY=your-ollama-cloud-key
# OLLAMA_API_HOST=https://ollama.com
# OLLAMA_API_MODEL=gemma4:cloud
# OLLAMA_API_FALLBACK_MODEL=gpt-oss:20b
