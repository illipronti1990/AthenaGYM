PORT=3001
HOST=0.0.0.0

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=

# Separar por vírgula. Dev: localhost. Produção: domínio Movvo (+ www + legado Vercel)
CORS_ORIGINS=http://localhost:3000
# Produção:
# CORS_ORIGINS=https://movvoerp.com.br,https://www.movvoerp.com.br,https://athena-gym.vercel.app
PASSWORD_RESET_REDIRECT=http://localhost:3000/login
# Produção:
# PASSWORD_RESET_REDIRECT=https://movvoerp.com.br/login

FINANCE_WEBHOOK_SECRET=athena-stub-secret
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Opcional (worker). API core funciona sem Redis.
REDIS_URL=

# G-17 — worker health (API agrega em /health e /health/queues)
WORKER_HEALTH_URL=

# G-17 — OpenTelemetry / Sentry (opcional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=athena-api
SENTRY_DSN=
LOG_LEVEL=info

QR_SIGNING_SECRET=change-me-qr-signing

# G-16 — AES-256-GCM for integration_secrets (required in production)
SECRETS_ENCRYPTION_KEY=change-me-32+chars-secrets-key

# Marketing landing (M-2/M-3) — webhook opcional (Slack/Make)
MARKETING_WEBHOOK_URL=
RESEND_API_KEY=
MARKETING_EMAIL_FROM=Movvo <noreply@movvoerp.com.br>
MARKETING_OPS_EMAIL=vendas@movvoerp.com.br

# Local DEV login. NUNCA true em produção.
DEV_AUTH_ENABLED=false
DEV_JWT_SECRET=change-me-dev-only

# Ollama Cloud — Athena AI (chat/insights). Copiar de cloud/api/.env em local.
OLLAMA_API_KEY=
OLLAMA_API_HOST=https://ollama.com
# Modelos cloud: gemma4:cloud (recomendado). Fallback free: gpt-oss:20b
# glm-5.2:cloud exige assinatura Ollama Pro
OLLAMA_API_MODEL=gemma4:cloud
# OLLAMA_TIMEOUT_MS=60000
# Fallback se o modelo principal retornar 403 de assinatura
OLLAMA_API_FALLBACK_MODEL=gpt-oss:20b
